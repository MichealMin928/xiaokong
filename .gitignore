# Local development and private acceptance data
.gradle/
.kotlin/
.tools/
.idea/
.cache/
local.properties
**/build/
*.iml
.DS_Store
__pycache__/
*.pyc
.venv/
.env
.env.*
*.jks
*.keystore
*signing*.properties
/evidence/
/checkpoints/
/releases/
/app/src/privateTest/
/app/src/debug/assets/
