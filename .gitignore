# Downloaded artifacts are pinned in config/artifacts.json, not stored in Git.
*.aar
*.apk
*.aab
*.onnx
*.task
*.wav

# Historical internal documents and device-specific scripts stay on this machine.
/docs/*
!/docs/public/
/scripts/*
!/scripts/fetch-artifacts.py
!/scripts/check-public-tree.py
!/scripts/build-command-pronunciation.py
!/scripts/verify-apk.py
!/scripts/tests/
